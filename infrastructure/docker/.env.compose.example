PUBLIC_SITE_URL=https://portfolio.example.com
SITE_ADDRESS=https://portfolio.example.com
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio_app
POSTGRES_PASSWORD=generate-a-long-random-password
DATABASE_URL=postgresql://portfolio_app:replace-me@postgres:5432/portfolio?schema=public
MINIO_ROOT_USER=generate-a-random-root-user
MINIO_ROOT_PASSWORD=generate-a-long-random-password
MINIO_BUCKET=portfolio-media
MINIO_ACCESS_KEY_ID=portfolio-app
MINIO_SECRET_ACCESS_KEY=generate-a-long-random-password
SESSION_SECRET=generate-at-least-32-random-bytes
CSRF_SECRET=generate-different-at-least-32-random-bytes
RECOVERY_SECRET=generate-a-third-at-least-32-random-bytes
CACHE_INVALIDATION_SECRET=generate-a-fourth-at-least-32-random-bytes
CONTACT_FROM_EMAIL=portfolio@example.com
SMTP_URL=smtps://user:password@smtp.example.com:465
WEBAUTHN_RP_ID=portfolio.example.com
WEBAUTHN_RP_NAME=Portfolio Admin
WEBAUTHN_ORIGIN=https://portfolio.example.com
# Caddy -> Next.js -> API. Change only when the private proxy topology changes.
API_TRUST_PROXY_HOPS=2
PUBLICATION_QUEUE_MAX_AGE_SECONDS=300
PUBLICATION_WORKER_LEASE_SECONDS=300
PUBLICATION_WORKER_IDLE_MS=2000
SCHEDULER_POLL_SECONDS=60
CONTACT_DELIVERY_MAX_ATTEMPTS=5
MAINTENANCE_INTERVAL_SECONDS=900
MAINTENANCE_BATCH_SIZE=100
DRAFT_RETENTION_DAYS=30
MEDIA_RETENTION_DAYS=30
QUARANTINE_RETENTION_DAYS=14

# Nightly encrypted PostgreSQL + MinIO backup. Times use BACKUP_TIME_ZONE.
BACKUP_TIME_ZONE=Asia/Tehran
BACKUP_TIME=02:00
BACKUP_RUN_ON_START=false
BACKUP_RETENTION_DAYS=30
# Mark the service unhealthy if no complete backup+delivery succeeds for 26h.
BACKUP_HEALTH_MAX_AGE_MINUTES=1560
# Telegram's hosted Bot API has a per-document limit. Larger archives are split.
TELEGRAM_MAX_FILE_BYTES=45000000
TELEGRAM_UPLOAD_RETRIES=4
# These files are mounted as Compose secrets. Create them with restrictive
# permissions; never commit their contents.
BACKUP_PASSPHRASE_PATH=./secrets/backup-passphrase
TELEGRAM_BOT_TOKEN_PATH=./secrets/telegram-bot-token
TELEGRAM_CHAT_ID_PATH=./secrets/telegram-chat-id
