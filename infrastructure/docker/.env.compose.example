PUBLIC_SITE_URL=https://portfolio.example.com
SITE_ADDRESS=https://portfolio.example.com
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio_app
POSTGRES_PASSWORD=generate-a-long-random-password
DATABASE_URL=postgresql://portfolio_app:replace-me@postgres:5432/portfolio?schema=public
MINIO_ROOT_USER=generate-a-random-root-user
MINIO_ROOT_PASSWORD=generate-a-long-random-password
MINIO_BUCKET=portfolio-media
MINIO_ACCESS_KEY_ID=portfolio-app
MINIO_SECRET_ACCESS_KEY=generate-a-long-random-password
SESSION_SECRET=generate-at-least-32-random-bytes
CSRF_SECRET=generate-different-at-least-32-random-bytes
RECOVERY_SECRET=generate-a-third-at-least-32-random-bytes
CACHE_INVALIDATION_SECRET=generate-a-fourth-at-least-32-random-bytes
CONTACT_FROM_EMAIL=portfolio@example.com
