{
  "name": "@portfolio/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start:worker": "node dist/worker/main.js --mode=publication",
    "start:scheduler": "node dist/worker/main.js --mode=scheduler",
    "dev:worker": "tsx src/worker/main.ts --mode=publication",
    "dev:scheduler": "tsx src/worker/main.ts --mode=scheduler",
    "verify:cutover": "tsx scripts/verify-public-cutover.ts --apply",
    "verify:auth": "tsx scripts/verify-auth-boundary.ts --apply"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1103.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/csrf-protection": "8.0.1",
    "@fastify/helmet": "13.1.0",
    "@fastify/multipart": "10.1.0",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-fastify": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/throttler": "6.5.0",
    "@portfolio/auth-core": "workspace:*",
    "@portfolio/contracts": "workspace:*",
    "@portfolio/database": "workspace:*",
    "@portfolio/media": "workspace:*",
    "@portfolio/markdown": "workspace:*",
    "@simplewebauthn/server": "13.3.2",
    "argon2": "0.45.1",
    "fastify": "5.11.2",
    "file-type": "22.0.1",
    "nestjs-pino": "4.6.1",
    "nodemailer": "9.0.4",
    "pino": "10.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.1.28",
    "@types/node": "24.13.3",
    "@types/nodemailer": "8.0.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.8.0",
    "globals": "17.9.0",
    "supertest": "7.2.2",
    "tsx": "4.23.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  }
}
