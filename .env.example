# Public/runtime routing
NODE_ENV=development
# Absolute origin. Used as the Next.js metadataBase for canonical and Open Graph
# URLs; the production build fails fast rather than defaulting to localhost.
PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=/api/v1
API_HOST=0.0.0.0
API_PORT=4000

# Owner date of birth, YYYY-MM-DD. Server-only and deliberately not
# NEXT_PUBLIC_: the visitor sees the derived age, never the date. Moves into
# SiteSettings during the M2 migration.
BIRTH_DATE=2000-01-01

# Locales. Closed allowlist; adding one is a code change, not just config.
DEFAULT_LOCALE=en
ENABLED_LOCALES=en,fa

# PostgreSQL. Replace every credential before using outside local development.
DATABASE_URL=postgresql://portfolio:change_me@localhost:5432/portfolio?schema=public

# Authentication. Generate independent random values; never reuse examples.
SESSION_SECRET=replace_with_at_least_32_random_bytes
CSRF_SECRET=replace_with_a_different_32_byte_random_value
# One-time owner provisioning. Supply these only through a secret mount/job,
# then remove the bootstrap token file after a successful `provision:owner` run.
OWNER_BOOTSTRAP_TOKEN_FILE=/run/secrets/owner_bootstrap_token
OWNER_BOOTSTRAP_EXPIRES_AT=2026-12-31T00:00:00Z
OWNER_EMAIL=owner@example.com
OWNER_DISPLAY_NAME=Portfolio Owner
OWNER_INITIAL_PASSWORD=replace_with_a_long_unique_password
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Portfolio Admin
WEBAUTHN_ORIGIN=http://localhost:3000

# MinIO media storage (server-only; these are app-scoped credentials)
MINIO_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_BUCKET=portfolio-media
MINIO_ACCESS_KEY_ID=replace_me
MINIO_SECRET_ACCESS_KEY=replace_me
MINIO_FORCE_PATH_STYLE=true

# Server-side contact email adapter. Never expose these values to the browser.
SMTP_URL=smtp://username:password@localhost:1025
CONTACT_FROM_EMAIL=portfolio@localhost

# Content store (Git). Article bodies live in the repository; see docs/CONTENT_PIPELINE.md.
# Use a GitHub App installation scoped to THIS repository with contents:write only.
# It must not have permission to modify workflow files.
CONTENT_GIT_PROVIDER=github
CONTENT_GIT_REPO=owner/repo
CONTENT_GIT_BRANCH=content
CONTENT_GIT_CONTENT_PREFIX=content/
CONTENT_GIT_APP_ID=replace_me
CONTENT_GIT_INSTALLATION_ID=replace_me
# Mount as a file in production rather than an inline value.
CONTENT_GIT_PRIVATE_KEY_PATH=/run/secrets/content_git_app_key.pem
# Independent of every other secret. Used to verify the inbound webhook signature.
CONTENT_GIT_WEBHOOK_SECRET=replace_with_an_independent_32_byte_random_value
CONTENT_GIT_BOT_NAME=portfolio-bot
CONTENT_GIT_BOT_EMAIL=bot@example.invalid

# Signed server-to-server cache invalidation. Independent of every other secret.
CACHE_INVALIDATION_SECRET=replace_with_another_independent_32_byte_random_value

# Scheduled publishing. Exactly one logical scheduler instance may be enabled.
SCHEDULER_ENABLED=true
SCHEDULER_POLL_SECONDS=60
