# Public/runtime routing
NODE_ENV=development
# Absolute origin. Used as the Next.js metadataBase for canonical and Open Graph
# URLs; the production build fails fast rather than defaulting to localhost.
PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=/api/v1
API_INTERNAL_ORIGIN=http://127.0.0.1:4000
# `database` is the target path. Set `legacy` only for the tested M2/M4 rollback.
PORTFOLIO_DATA_SOURCE=database
API_HOST=0.0.0.0
API_PORT=4000

# Legacy-rollback date of birth, YYYY-MM-DD. Server-only and deliberately not
# NEXT_PUBLIC_: database mode derives age from SiteSettings and never exposes
# the date. Keep this only while the tested rollback adapter remains available.
BIRTH_DATE=2000-01-01

# Locales. Closed allowlist; adding one is a code change, not just config.
DEFAULT_LOCALE=en
ENABLED_LOCALES=en,fa

# PostgreSQL. Replace every credential before using outside local development.
DATABASE_URL=postgresql://portfolio:change_me@localhost:5432/portfolio?schema=public

# Authentication. Generate independent random values; never reuse examples.
SESSION_SECRET=replace_with_at_least_32_random_bytes
CSRF_SECRET=replace_with_a_different_32_byte_random_value
# Keys the recovery-code hashes. Independent again: a leak of the session or
# CSRF secret must not make the stored recovery hashes forgeable.
RECOVERY_SECRET=replace_with_a_third_32_byte_random_value
# One-time owner provisioning. Supply these only through a secret mount/job,
# then remove the bootstrap token file after a successful `provision:owner` run.
OWNER_BOOTSTRAP_TOKEN_FILE=/run/secrets/owner_bootstrap_token
OWNER_BOOTSTRAP_EXPIRES_AT=2026-12-31T00:00:00Z
OWNER_EMAIL=owner@example.com
OWNER_DISPLAY_NAME=Portfolio Owner
OWNER_INITIAL_PASSWORD=replace_with_a_long_unique_password
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Portfolio Admin
WEBAUTHN_ORIGIN=http://localhost:3000

# MinIO media storage (server-only; these are app-scoped credentials)
MINIO_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_BUCKET=portfolio-media
MINIO_ACCESS_KEY_ID=replace_me
MINIO_SECRET_ACCESS_KEY=replace_me
MINIO_FORCE_PATH_STYLE=true

# Server-side contact email adapter. Never expose these values to the browser.
SMTP_URL=smtp://username:password@localhost:1025
CONTACT_FROM_EMAIL=portfolio@localhost
# Failed deliveries are retried by the single maintenance worker with bounded
# exponential backoff. Exhausted rows remain visible until retention purges them.
CONTACT_DELIVERY_MAX_ATTEMPTS=5

# Optional read-only GitHub token for server-side project statistics. The
# repository owner, explicit allowlist, and TTL come from SiteSettings. Leave
# unset for unauthenticated public-repository requests; never prefix with
# NEXT_PUBLIC_.
GITHUB_STATS_TOKEN=

# Background publication worker. HTTP API replicas ignore these values and run no timers.
PUBLICATION_WORKER_LEASE_SECONDS=300
PUBLICATION_WORKER_IDLE_MS=2000
# Queue age at which readiness reports publication work as backlogged. Public
# reads remain available because they use already-validated PostgreSQL rows.
PUBLICATION_QUEUE_MAX_AGE_SECONDS=300

# Signed server-to-server cache invalidation. Independent of every other secret.
# The worker signs with it; the web app verifies with it. Leave the URL unset to
# run without invalidation delivery — events still accumulate in the outbox, and
# pages correct themselves when their revalidate window lapses.
CACHE_INVALIDATION_SECRET=replace_with_another_independent_32_byte_random_value
CACHE_INVALIDATION_URL=http://localhost:3000/api/invalidate

# Scheduled publishing. Exactly one logical scheduler instance may be enabled.
SCHEDULER_ENABLED=true
SCHEDULER_POLL_SECONDS=60

# Single-instance operational maintenance: contact retention/retry, expired
# import-report removal, and terminal/archived orphan media cleanup.
MAINTENANCE_INTERVAL_SECONDS=900
MAINTENANCE_BATCH_SIZE=100
MEDIA_RETENTION_DAYS=30
QUARANTINE_RETENTION_DAYS=14
