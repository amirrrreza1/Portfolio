{
  "name": "@portfolio/database",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm --filter @portfolio/tooling exec tsc -p ../../packages/database/tsconfig.json",
    "typecheck": "pnpm --filter @portfolio/tooling exec tsc -p ../../packages/database/tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "pnpm --filter @portfolio/tooling exec prisma generate --config ../../packages/database/prisma.config.ts",
    "db:validate": "pnpm --filter @portfolio/tooling exec prisma validate --config ../../packages/database/prisma.config.ts",
    "db:format": "pnpm --filter @portfolio/tooling exec prisma format --config ../../packages/database/prisma.config.ts",
    "db:migrate": "pnpm --filter @portfolio/tooling exec prisma migrate dev --config ../../packages/database/prisma.config.ts",
    "db:reset": "pnpm --filter @portfolio/tooling exec prisma migrate reset --force --config ../../packages/database/prisma.config.ts",
    "db:constraints": "node scripts/stage-constraints.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "verify:articles": "tsx scripts/verify-article-authority.ts --apply",
    "provision:owner": "pnpm --filter @portfolio/auth-core build && tsx scripts/provision-owner.ts --apply",
    "revoke:credentials": "tsx scripts/revoke-credentials.ts",
    "migrate:legacy": "pnpm --filter @portfolio/media build && pnpm --filter @portfolio/migration build && tsx scripts/migrate-legacy.ts --apply",
    "migrate:github-stats": "pnpm --filter @portfolio/migration build && tsx scripts/migrate-github-stats.ts --apply"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@portfolio/auth-core": "workspace:*",
    "@portfolio/contracts": "workspace:*",
    "@portfolio/markdown": "workspace:*",
    "@portfolio/media": "workspace:*",
    "@portfolio/migration": "workspace:*",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@types/pg": "8.20.4",
    "dotenv": "17.2.4",
    "tsx": "4.23.7",
    "vitest": "4.1.10"
  }
}
